# Azure Portal > Document Intelligence > Keys and Endpoint
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=replace-with-your-key

# 4 MB works with both the F0 and S0 Azure tiers. Increase it if your tier allows it.
RECEIPT_MAX_FILE_SIZE_BYTES=4194304

# Endpoint de la API matriz que recibe multipart/form-data con las partes `Datos` e `Imagen`.
MATRIX_RECEIPTS_API_URL=https://intranetapi.azurewebsites.net/api/NotasGastos/ticket

# Opcional: se enviará como Authorization: Bearer <token>.
MATRIX_RECEIPTS_API_TOKEN=
